@page
@model CleanupModel
@{
    ViewData["Title"] = "Device Cleanup Management";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-trash-alt"></i> Device Cleanup Management
            </h1>
            <p class="lead text-muted">Manage automatic cleanup of inactive devices</p>
        </div>
        <div class="col-auto">
            <a asp-page="/Devices/List" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Back to Devices
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Config != null)
    {
        <!-- Cleanup Configuration Card -->
        <div class="row mb-4">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-cog"></i> Cleanup Configuration
                        </h5>
                    </div>
                    <div class="card-body">
                        <form id="configForm">
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="enabled" 
                                           @(Model.Config.Enabled ? "checked" : "")>
                                    <label class="form-check-label" for="enabled">
                                        <strong>Enable Automatic Cleanup</strong>
                                    </label>
                                </div>
                                <small class="form-text text-muted">
                                    When enabled, inactive devices will be automatically deleted based on the threshold below.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label for="threshold" class="form-label">
                                    <i class="fas fa-calendar-alt"></i> Inactivity Threshold (Days)
                                </label>
                                <input type="number" class="form-control" id="threshold" 
                                       value="@Model.Config.InactiveDaysThreshold" min="1" max="365">
                                <small class="form-text text-muted">
                                    Devices inactive for more than this many days will be eligible for cleanup.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label for="schedule" class="form-label">
                                    <i class="fas fa-clock"></i> Cleanup Schedule
                                </label>
                                <input type="text" class="form-control" id="schedule" 
                                       value="@Model.Config.CleanupSchedule" readonly>
                                <small class="form-text text-muted">
                                    Cron expression for automatic cleanup schedule. Currently: Daily at 2:00 AM UTC
                                </small>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="deleteData" 
                                           @(Model.Config.DeleteAssociatedData ? "checked" : "")>
                                    <label class="form-check-label" for="deleteData">
                                        Delete Associated Reports and Events
                                    </label>
                                </div>
                                <small class="form-text text-muted">
                                    When enabled, all reports, events, and commands associated with deleted devices will also be removed.
                                </small>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="notify" 
                                           @(Model.Config.NotifyOnCleanup ? "checked" : "")>
                                    <label class="form-check-label" for="notify">
                                        Send Email Notification
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3" id="emailGroup" style="display: @(Model.Config.NotifyOnCleanup ? "block" : "none")">
                                <label for="email" class="form-label">
                                    <i class="fas fa-envelope"></i> Notification Email
                                </label>
                                <input type="email" class="form-control" id="email" 
                                       value="@Model.Config.NotificationEmail" 
                                       placeholder="admin@example.com">
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Save Configuration
                                </button>
                            </div>
                        </form>
                    </div>
                    @if (Model.Config.LastCleanupRunUtc.HasValue)
                    {
                        <div class="card-footer bg-light">
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> 
                                Last cleanup: @Model.Config.LastCleanupRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                (@Model.Config.LastCleanupDeviceCount devices deleted)
                            </small>
                        </div>
                    }
                </div>
            </div>

            <!-- Statistics Card -->
            <div class="col-lg-6">
                <div class="card mb-3">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-bar"></i> Cleanup Statistics
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6 mb-3">
                                <div class="card bg-warning text-dark">
                                    <div class="card-body py-2">
                                        <h3 class="mb-0">@(Model.Preview?.DeviceCount ?? 0)</h3>
                                        <small>Devices Eligible for Cleanup</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="card bg-secondary text-white">
                                    <div class="card-body py-2">
                                        <h3 class="mb-0">@Model.Config.InactiveDaysThreshold</h3>
                                        <small>Days Threshold</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (Model.Preview?.CutoffDate != null)
                        {
                            <hr>
                            <p class="mb-0">
                                <i class="fas fa-calendar-times"></i> 
                                <strong>Cutoff Date:</strong> @Model.Preview.CutoffDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </p>
                            <small class="text-muted">
                                Devices not seen since this date will be deleted
                            </small>
                        }
                    </div>
                </div>

                <!-- Manual Actions Card -->
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Manual Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">
                            <i class="fas fa-info-circle"></i> 
                            Manually trigger cleanup operations. Use with caution - this action cannot be undone!
                        </p>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-warning" id="previewBtn">
                                <i class="fas fa-eye"></i> Preview Devices to be Deleted
                            </button>
                            <button type="button" class="btn btn-danger" id="runCleanupBtn">
                                <i class="fas fa-trash"></i> Run Cleanup Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Devices to be Cleaned Up Table -->
        @if (Model.Preview?.Devices.Any() == true)
        {
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> 
                        Devices Eligible for Cleanup (@Model.Preview.DeviceCount)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        <input type="checkbox" id="selectAll" class="form-check-input">
                                    </th>
                                    <th><i class="fas fa-desktop"></i> Device</th>
                                    <th><i class="fas fa-network-wired"></i> Domain</th>
                                    <th><i class="fas fa-clock"></i> Last Seen</th>
                                    <th><i class="fas fa-calendar-times"></i> Days Inactive</th>
                                    <th><i class="fas fa-file-alt"></i> Reports</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in Model.Preview.Devices.OrderByDescending(d => d.DaysInactive))
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input device-checkbox" 
                                                   data-device-id="@device.Id" 
                                                   data-device-name="@device.MachineName">
                                        </td>
                                        <td>
                                            <strong>@device.MachineName</strong>
                                        </td>
                                        <td>@(device.DomainName ?? "-")</td>
                                        <td>@device.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <span class="badge @(device.DaysInactive > 180 ? "bg-danger" : device.DaysInactive > 90 ? "bg-warning text-dark" : "bg-secondary")">
                                                @device.DaysInactive days
                                            </span>
                                        </td>
                                        <td>@device.ReportCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                        <button type="button" class="btn btn-danger" id="deleteSelectedBtn">
                            <i class="fas fa-trash"></i> Delete Selected Devices
                        </button>
                        <span class="ms-3 text-muted" id="selectedCount">0 devices selected</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success">
                <h4 class="alert-heading"><i class="fas fa-check-circle"></i> No Devices Eligible for Cleanup</h4>
                <p>There are currently no inactive devices that meet the cleanup threshold of @Model.Config.InactiveDaysThreshold days.</p>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        const apiBaseUrl = document.querySelector('meta[name="api-base-url"]').content;

        // Toggle email input visibility
        document.getElementById('notify').addEventListener('change', function() {
            document.getElementById('emailGroup').style.display = this.checked ? 'block' : 'none';
        });

        // Select All checkbox
        document.getElementById('selectAll')?.addEventListener('change', function() {
            document.querySelectorAll('.device-checkbox').forEach(cb => {
                cb.checked = this.checked;
            });
            updateSelectedCount();
        });

        // Update selected count
        document.querySelectorAll('.device-checkbox').forEach(cb => {
            cb.addEventListener('change', updateSelectedCount);
        });

        function updateSelectedCount() {
            const count = document.querySelectorAll('.device-checkbox:checked').length;
            document.getElementById('selectedCount').textContent = `${count} device${count !== 1 ? 's' : ''} selected`;
        }

        // Save configuration
        document.getElementById('configForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const config = {
                enabled: document.getElementById('enabled').checked,
                inactiveDaysThreshold: parseInt(document.getElementById('threshold').value),
                cleanupSchedule: document.getElementById('schedule').value,
                deleteAssociatedData: document.getElementById('deleteData').checked,
                notifyOnCleanup: document.getElementById('notify').checked,
                notificationEmail: document.getElementById('email').value || null
            };

            try {
                const response = await fetch(`${apiBaseUrl}/api/DeviceCleanup/config`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(config)
                });

                if (response.ok) {
                    alert('Configuration saved successfully!');
                    location.reload();
                } else {
                    const error = await response.json();
                    alert(`Error saving configuration: ${error.error || response.statusText}`);
                }
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        });

        // Preview cleanup
        document.getElementById('previewBtn')?.addEventListener('click', async function() {
            const threshold = parseInt(document.getElementById('threshold').value);
            window.location.href = `?threshold=${threshold}`;
        });

        // Run cleanup now
        document.getElementById('runCleanupBtn')?.addEventListener('click', async function() {
            if (!confirm('Are you sure you want to run cleanup now? This will delete all inactive devices and cannot be undone!')) {
                return;
            }

            try {
                const response = await fetch(`${apiBaseUrl}/api/DeviceCleanup/run`, {
                    method: 'POST'
                });

                if (response.ok) {
                    const result = await response.json();
                    alert(`Cleanup completed successfully!\n${result.deletedCount} devices deleted.`);
                    location.reload();
                } else {
                    const error = await response.json();
                    alert(`Error running cleanup: ${error.error || response.statusText}`);
                }
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        });

        // Delete selected devices
        document.getElementById('deleteSelectedBtn')?.addEventListener('click', async function() {
            const selectedCheckboxes = document.querySelectorAll('.device-checkbox:checked');
            
            if (selectedCheckboxes.length === 0) {
                alert('Please select at least one device to delete.');
                return;
            }

            const deviceIds = Array.from(selectedCheckboxes).map(cb => cb.dataset.deviceId);
            const deviceNames = Array.from(selectedCheckboxes).map(cb => cb.dataset.deviceName).join(', ');

            if (!confirm(`Are you sure you want to delete ${deviceIds.length} device(s)?\n\nDevices:\n${deviceNames}\n\nThis action cannot be undone!`)) {
                return;
            }

            try {
                const response = await fetch(`${apiBaseUrl}/api/DeviceCleanup/delete`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ deviceIds })
                });

                if (response.ok) {
                    const result = await response.json();
                    alert(`Successfully deleted ${result.deletedCount} device(s)!`);
                    location.reload();
                } else {
                    const error = await response.json();
                    alert(`Error deleting devices: ${error.error || response.statusText}`);
                }
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        });
    </script>
}

@section Styles {
    <style>
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(220, 53, 69, 0.25);
        }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(255, 193, 7, 0.25);
        }
    </style>
}
