@page
@model ListModel
@{
    ViewData["Title"] = "Monitored Devices";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-laptop"></i> Monitored Devices
            </h1>
            <p class="lead text-muted">Complete list of Windows devices with Secure Boot certificates</p>
        </div>
        <div class="col-auto">
            <a asp-page="/Index" class="btn btn-outline-primary">
                <i class="fas fa-chart-line"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Devices.Any())
    {
        <!-- Statistics Cards (Mini) -->
        <div class="row mb-4">
            <div class="col-md-2">
                <div class="card text-center border-primary">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Total</small>
                        <h4 class="mb-0">@Model.TotalDevices</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center border-success">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Deployed</small>
                        <h4 class="mb-0 text-success">@Model.DeployedDevices</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center border-warning">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Pending</small>
                        <h4 class="mb-0 text-warning">@Model.PendingDevices</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center border-danger">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Error</small>
                        <h4 class="mb-0 text-danger">@Model.ErrorDevices</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center border-info">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Attivi (24h)</small>
                        <h4 class="mb-0 text-info">@Model.ActiveDevices</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center border-secondary">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Inattivi (>7d)</small>
                        <h4 class="mb-0 text-secondary">@Model.InactiveDevices</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label for="search" class="form-label">
                            <i class="fas fa-search"></i> Search
                        </label>
                        <input type="text" class="form-control" id="search" name="search" 
                               placeholder="Nome macchina, dominio, produttore..." 
                               value="@Model.SearchTerm">
                    </div>
                    <div class="col-md-3">
                        <label for="state" class="form-label">
                            <i class="fas fa-filter"></i> Status
                        </label>
                        <select class="form-select" id="state" name="state">
                            <option value="">All</option>
                            <option value="Deployed" selected="@(Model.FilterState == "Deployed")">Deployed</option>
                            <option value="Pending" selected="@(Model.FilterState == "Pending")">Pending</option>
                            <option value="Error" selected="@(Model.FilterState == "Error")">Error</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="fleet" class="form-label">
                            <i class="fas fa-layer-group"></i> Fleet
                        </label>
                        <select class="form-select" id="fleet" name="fleet">
                            <option value="">All</option>
                            @foreach (var fleetId in Model.AvailableFleets)
                            {
                                <option value="@fleetId" selected="@(Model.FilterFleet == fleetId)">@fleetId</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-filter"></i> Apply
                        </button>
                        <a asp-page="/Devices/List" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Devices Table -->
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-list"></i> 
                    @Model.FilteredDevices.Count dispositivi
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.FilterState) || !string.IsNullOrEmpty(Model.FilterFleet))
                    {
                        <span class="badge bg-light text-dark ms-2">Filtered</span>
                    }
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-desktop"></i> Device</th>
                                <th><i class="fas fa-network-wired"></i> Domain</th>
                                <th><i class="fas fa-layer-group"></i> Fleet</th>
                                <th><i class="fas fa-code-branch"></i> Version</th>
                                <th><i class="fas fa-industry"></i> Manufacturer / Model</th>
                                <th><i class="fas fa-shield-alt"></i> Secure Boot</th>
                                <th><i class="fas fa-certificate"></i> OEM Cert</th>
                                <th><i class="fas fa-file-alt"></i> Reports</th>
                                <th><i class="fas fa-traffic-light"></i> State</th>
                                <th><i class="fas fa-check-circle"></i> Ready to Update</th>
                                <th><i class="fas fa-clock"></i> Last Seen</th>
                                <th class="text-end"><i class="fas fa-cog"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in Model.FilteredDevices.OrderByDescending(d => d.LastSeenUtc))
                            {
                                var timeSinceLastSeen = DateTimeOffset.UtcNow - device.LastSeenUtc;
                                var lastSeenText = timeSinceLastSeen.TotalMinutes < 60
                                    ? $"{(int)timeSinceLastSeen.TotalMinutes} min ago"
                                    : timeSinceLastSeen.TotalHours < 24
                                        ? $"{(int)timeSinceLastSeen.TotalHours} hours ago"
                                        : $"{(int)timeSinceLastSeen.TotalDays} days ago";

                                var isInactive = timeSinceLastSeen.TotalDays > 7;
                                var rowClass = isInactive ? "table-secondary" : "";

                                <tr class="@rowClass">
                                    <td>
                                        @{
                                            var osIconClass = "fa-desktop"; // Default to workstation
                                            var osColorClass = "text-primary";
                                            var osTitle = "Workstation";
                                            
                                            // Check if Virtual Machine first
                                            if (device.IsVirtualMachine == true)
                                            {
                                                osIconClass = "fa-cloud";
                                                osColorClass = "text-info";
                                                osTitle = $"Virtual Machine ({device.VirtualizationPlatform ?? "Unknown"})";
                                            }
                                            // Determine OS icon based on ProductType
                                            else if (device.OSProductType.HasValue)
                                            {
                                                switch (device.OSProductType.Value)
                                                {
                                                    case 1: // Workstation
                                                        osIconClass = "fa-desktop";
                                                        osColorClass = "text-primary";
                                                        osTitle = "Workstation";
                                                        break;
                                                    case 2: // Domain Controller
                                                        osIconClass = "fa-building";
                                                        osColorClass = "text-warning";
                                                        osTitle = "Domain Controller";
                                                        break;
                                                    case 3: // Server
                                                        osIconClass = "fa-server";
                                                        osColorClass = "text-success";
                                                        osTitle = "Server";
                                                        break;
                                                    default:
                                                        osIconClass = "fa-question-circle";
                                                        osColorClass = "text-secondary";
                                                        osTitle = "Unknown";
                                                        break;
                                                }
                                            }

                                            // Determine chassis icon/badge based on ChassisTypes
                                            var chassisBadge = "";
                                            var chassisTitle = "";
                                            if (!string.IsNullOrEmpty(device.ChassisTypesJson))
                                            {
                                                try
                                                {
                                                    var chassisTypes = System.Text.Json.JsonSerializer.Deserialize<int[]>(device.ChassisTypesJson);
                                                    if (chassisTypes != null && chassisTypes.Length > 0)
                                                    {
                                                        // Check for portable (laptop, notebook, tablet)
                                                        var portableTypes = new[] { 8, 9, 10, 11, 14, 30, 31, 32 };
                                                        var isPortable = chassisTypes.Any(ct => portableTypes.Contains(ct));
                                                        
                                                        if (isPortable)
                                                        {
                                                            chassisBadge = "<i class=\"fas fa-laptop text-info ms-1\" style=\"font-size: 0.8em;\"></i>";
                                                            chassisTitle = " (Portable)";
                                                        }
                                                        else
                                                        {
                                                            // Desktop tower types
                                                            var desktopTypes = new[] { 3, 4, 6, 7, 13, 15 };
                                                            if (chassisTypes.Any(ct => desktopTypes.Contains(ct)))
                                                            {
                                                                chassisBadge = "<i class=\"fas fa-hdd text-secondary ms-1\" style=\"font-size: 0.8em;\"></i>";
                                                                chassisTitle = " (Desktop)";
                                                            }
                                                        }
                                                    }
                                                }
                                                catch
                                                {
                                                    // JSON parsing failed, ignore
                                                }
                                            }
                                        }
                                        <i class="fas @osIconClass @osColorClass me-2" title="@(osTitle + chassisTitle)" data-bs-toggle="tooltip"></i>
                                        <a asp-page="/Devices/Details" asp-route-id="@device.Id" 
                                           class="text-decoration-none fw-bold machine-name-link" 
                                           title="View device details">
                                            @device.MachineName
                                        </a>
                                        @Html.Raw(chassisBadge)
                                        @if (isInactive)
                                        {
                                            <span class="badge bg-secondary ms-2" title="Device inactive for more than 7 days">
                                                <i class="fas fa-moon"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>@(device.DomainName ?? "-")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(device.FleetId))
                                        {
                                            <span class="badge bg-info">
                                                <i class="fas fa-tag"></i> @device.FleetId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(device.ClientVersion))
                                        {
                                            <code class="text-muted small">@device.ClientVersion</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @(device.Manufacturer ?? "Unknown") / @(device.Model ?? "Unknown")
                                        </small>
                                    </td>
                                    <td>
                                        @if (device.UEFISecureBootEnabled.HasValue)
                                        {
                                            if (device.UEFISecureBootEnabled.Value)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle"></i> Enabled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle"></i> Disabled
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-question-circle"></i> Unknown
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            // Build OEM Certificate status tooltip
                                            var oemCertTooltipParts = new List<string>();
                                            var totalOemCerts = device.ExpiredOemCertificateCount + 
                                                              device.CriticalOemCertificateCount + 
                                                              device.WarningOemCertificateCount + 
                                                              device.ValidOemCertificateCount;

                                            if (totalOemCerts > 0)
                                            {
                                                if (device.ValidOemCertificateCount > 0)
                                                    oemCertTooltipParts.Add($"{device.ValidOemCertificateCount} valid");
                                                if (device.WarningOemCertificateCount > 0)
                                                    oemCertTooltipParts.Add($"{device.WarningOemCertificateCount} expiring (<180 days)");
                                                if (device.CriticalOemCertificateCount > 0)
                                                    oemCertTooltipParts.Add($"{device.CriticalOemCertificateCount} critical (<90 days)");
                                                if (device.ExpiredOemCertificateCount > 0)
                                                    oemCertTooltipParts.Add($"{device.ExpiredOemCertificateCount} expired");
                                            }
                                            else
                                            {
                                                oemCertTooltipParts.Add("No OEM certificates found - verify if VM/consumer device or firmware read error");
                                            }

                                            var oemCertTooltip = string.Join("\n", oemCertTooltipParts);
                                        }

                                        @if (device.AreOemCertificatesValid)
                                        {
                                            <span class="badge bg-success" title="@oemCertTooltip">
                                                <i class="fas fa-check-circle"></i> Valid
                                            </span>
                                        }
                                        else if (device.ExpiredOemCertificateCount > 0)
                                        {
                                            <span class="badge bg-danger" title="@oemCertTooltip">
                                                <i class="fas fa-times-circle"></i> Expired (@device.ExpiredOemCertificateCount)
                                            </span>
                                        }
                                        else if (device.CriticalOemCertificateCount > 0)
                                        {
                                            <span class="badge bg-warning text-dark" title="@oemCertTooltip">
                                                <i class="fas fa-exclamation-triangle"></i> Critical (@device.CriticalOemCertificateCount)
                                            </span>
                                        }
                                        else if (device.WarningOemCertificateCount > 0)
                                        {
                                            <span class="badge bg-warning text-dark" title="@oemCertTooltip">
                                                <i class="fas fa-exclamation-circle"></i> Warning (@device.WarningOemCertificateCount)
                                            </span>
                                        }
                                        else if (device.HasNoOemCertificates)
                                        {
                                            <span class="badge bg-warning text-dark" title="@oemCertTooltip">
                                                <i class="fas fa-exclamation-triangle"></i> No OEM
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary" title="@oemCertTooltip">
                                                <i class="fas fa-question-circle"></i> Unknown
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@device.ReportCount</span>
                                    </td>
                                    <td>
                                        @switch (device.LatestDeploymentState)
                                        {
                                            case "Deployed":
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check"></i> Deployed
                                                </span>
                                                break;
                                            case "Updated":
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle"></i> Updated
                                                </span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">
                                                    <i class="fas fa-clock"></i> Pending
                                                </span>
                                                break;
                                            case "Error":
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times"></i> Error
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">
                                                    @(device.LatestDeploymentState ?? "Unknown")
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (device.IsReadyToUpdate)
                                        {
                                            <span class="badge bg-success" 
                                                  title="@device.CertificateEvaluationDetails&#10;@device.OSEvaluationDetails">
                                                <i class="fas fa-check-circle"></i> Ready
                                            </span>
                                        }
                                        else
                                        {
                                            var tooltipParts = new List<string>();
                                            var badgeClass = "bg-warning text-dark";
                                            var badgeIcon = "fa-exclamation-triangle";
                                            
                                            // Check certificate issues
                                            if (!device.AreOemCertificatesValid)
                                            {
                                                if (device.ExpiredOemCertificateCount > 0)
                                                {
                                                    tooltipParts.Add($"{device.ExpiredOemCertificateCount} OEM certificate(s) expired");
                                                    badgeClass = "bg-danger";
                                                    badgeIcon = "fa-times-circle";
                                                }
                                                else if (device.CriticalOemCertificateCount > 0)
                                                {
                                                    tooltipParts.Add($"{device.CriticalOemCertificateCount} OEM certificate(s) expiring soon");
                                                }
                                                else
                                                {
                                                    tooltipParts.Add("OEM certificate validation failed");
                                                }
                                            }
                                            
                                            if (!device.HasWindowsUEFICA2023)
                                            {
                                                tooltipParts.Add("Windows UEFI CA 2023 not found");
                                                badgeClass = "bg-danger";
                                                badgeIcon = "fa-times-circle";
                                            }
                                            
                                            if (!device.IsOSReady)
                                            {
                                                // Use detailed message from API invece di messaggio generico
                                                if (!string.IsNullOrEmpty(device.OSEvaluationDetails))
                                                {
                                                    tooltipParts.Add(device.OSEvaluationDetails);
                                                }
                                                else
                                                {
                                                    tooltipParts.Add("? OS build does not meet requirements");
                                                }
                                            }
                                            
                                            // Show warning count if present
                                            if (device.WarningOemCertificateCount > 0)
                                            {
                                                tooltipParts.Add($"{device.WarningOemCertificateCount} certificate(s) need attention");
                                            }
                                            
                                            var tooltipText = tooltipParts.Any() 
                                                ? string.Join("\n", tooltipParts) 
                                                : "Not ready for update";
                                            
                                            <span class="badge @badgeClass" title="@tooltipText">
                                                <i class="fas @badgeIcon"></i> Not Ready
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span title="@device.LastSeenUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                            @lastSeenText
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="/Devices/Details" asp-route-id="@device.Id" 
                                               class="btn btn-outline-primary" 
                                               title="View device details">
                                                <i class="fas fa-info-circle"></i> Details
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-outline-danger" 
                                                    title="Delete device"
                                                    data-device-id="@device.Id"
                                                    data-device-name="@device.MachineName"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteDeviceModal">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.ApiHealthy)
    {
        <div class="alert alert-info">
            <h4 class="alert-heading"><i class="fas fa-info-circle"></i> No Registered Devices</h4>
            <p>Non ci sono dispositivi da visualizzare. I client devono ancora inviare i dati all'API.</p>
            <hr>
            <p class="mb-0">
                <strong>Next steps:</strong>
            </p>
            <ol class="mb-0">
                <li>Configure the SecureBootWatcher client on Windows devices</li>
                <li>Verify that clients can reach the API</li>
                <li>Wait for clients to send the first report</li>
            </ol>
        </div>
    }
</div>

@section Styles {
    <style>
        .table-secondary {
            opacity: 0.7;
        }

        .machine-name-link {
            color: inherit;
            transition: all 0.2s ease-in-out;
        }

        .machine-name-link:hover {
            color: #0d6efd !important;
            text-decoration: underline !important;
        }

        /* Mini stat cards */
        .card-body.py-2 {
            padding-top: 0.5rem !important;
            padding-bottom: 0.5rem !important;
        }

        .card-body.py-2 small {
            font-size: 0.75rem;
        }

        .card-body.py-2 h4 {
            font-size: 1.5rem;
        }

        /* Filter form */
        .form-label {
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Table styling */
        .table thead th {
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
        }

        .btn-group-sm .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }
    </style>
}

<!-- Delete Device Modal -->
<div class="modal fade" id="deleteDeviceModal" tabindex="-1" aria-labelledby="deleteDeviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteDeviceModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirm Device Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle"></i> 
                    <strong>Warning:</strong> This action cannot be undone!
                </div>
                <p>Are you sure you want to permanently delete the following device?</p>
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-desktop"></i> <strong id="deviceNameToDelete"></strong>
                        </h6>
                    </div>
                </div>
                <p class="mt-3 mb-0">
                    <small class="text-muted">
                        This will permanently remove:
                    </small>
                </p>
                <ul class="small text-muted">
                    <li>Device information</li>
                    <li>All associated reports</li>
                    <li>All associated events</li>
                    <li>All pending commands</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteDevice">
                    <i class="fas fa-trash"></i> Yes, Delete Device
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = document.querySelector('meta[name="api-base-url"]').content;
        let currentDeviceId = null;

        // Set device info in delete modal
        const deleteDeviceModal = document.getElementById('deleteDeviceModal');
        deleteDeviceModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            currentDeviceId = button.getAttribute('data-device-id');
            const deviceName = button.getAttribute('data-device-name');

            const modalBody = deleteDeviceModal.querySelector('#deviceNameToDelete');
            modalBody.textContent = deviceName || 'Unknown Device';
        });

        // Handle confirm delete
        document.getElementById('confirmDeleteDevice').addEventListener('click', async function() {
            if (!currentDeviceId) {
                alert('Device ID not found');
                return;
            }

            const confirmBtn = this;
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';

            try {
                const response = await fetch(`${apiBaseUrl}/api/DeviceCleanup/delete`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        deviceIds: [currentDeviceId]
                    })
                });

                if (response.ok) {
                    const result = await response.json();
                    
                    // Close modal
                    const modalInstance = bootstrap.Modal.getInstance(deleteDeviceModal);
                    modalInstance.hide();
                    
                    // Show success message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success alert-dismissible fade show';
                    alertDiv.innerHTML = `
                        <i class="fas fa-check-circle"></i> 
                        Device deleted successfully! ${result.deletedCount} device(s) removed.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('.row'));
                    
                    // Reload page after short delay
                    setTimeout(() => location.reload(), 1500);
                } else {
                    const error = await response.json();
                    alert(`Error deleting device: ${error.error || response.statusText}`);
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="fas fa-trash"></i> Yes, Delete Device';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while deleting the device. Please try again.');
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-trash"></i> Yes, Delete Device';
            }
        });
    </script>
}
