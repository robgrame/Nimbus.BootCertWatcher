@page
@model SecureBootDashboard.Web.Pages.Settings.ApiConfig.IndexModel
@{
    ViewData["Title"] = "API Configuration";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="fas fa-server"></i> API Configuration</h2>
            <p class="text-muted">
                Manage Queue Processor, File Store, and Device Cleanup settings.
                The active configuration is loaded by the API at startup and cached for 5 minutes.
            </p>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Configuration
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-dismissible fade show" role="alert">
            <i class="fas fa-@(Model.IsSuccess ? "check-circle" : "exclamation-circle")"></i>
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Configurations == null || !Model.Configurations.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            No API configurations found. The API will use default settings from appsettings.json.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Status</th>
                                <th>Queue Processor</th>
                                <th>File Store</th>
                                <th>Device Cleanup</th>
                                <th>Description</th>
                                <th>Last Updated</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var config in Model.Configurations)
                            {
                                <tr class="@(config.IsActive ? "table-success" : "")">
                                    <td>
                                        <strong>#@config.Id</strong>
                                    </td>
                                    <td>
                                        @if (config.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-pause-circle"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (config.QueueProcessorEnabled)
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fas fa-play"></i> Enabled
                                            </span>
                                            <br />
                                            <small class="text-muted">
                                                Queue: @config.QueueName
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-stop"></i> Disabled
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (config.FileReportStoreEnabled)
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fas fa-folder"></i> Enabled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                    </td>
                                    <td>
                                        @if (config.DeviceCleanupEnabled)
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fas fa-broom"></i> Enabled
                                            </span>
                                            <br />
                                            <small class="text-muted">
                                                @config.DeviceCleanupDaysThreshold days
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(config.Description))
                                        {
                                            <span>@config.Description</span>
                                        }
                                        else
                                        {
                                            <em class="text-muted">No description</em>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @config.UpdatedAtUtc.ToLocalTime().ToString("g")
                                            @if (!string.IsNullOrEmpty(config.UpdatedBy))
                                            {
                                                <text><br />by @config.UpdatedBy</text>
                                            }
                                        </small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-page="Edit" asp-route-id="@config.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (!config.IsActive)
                                            {
                                                <form method="post" asp-page-handler="Activate" asp-route-id="@config.Id" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (config.Id != 1)
                                            {
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@config.Id" 
                                                      onsubmit="return confirm('Are you sure you want to delete this configuration?');" 
                                                      style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="alert alert-info mt-3">
            <i class="fas fa-info-circle"></i>
            <strong>Note:</strong>
            <ul class="mb-0">
                <li>Only one configuration can be active at a time</li>
                <li>The API caches configuration for 5 minutes - changes may take up to 5 minutes to take effect</li>
                <li>Activating a new configuration will deactivate all others automatically</li>
                <li>The default configuration (ID=1) cannot be deleted</li>
            </ul>
        </div>
    }
</div>
