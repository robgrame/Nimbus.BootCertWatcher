@page
@model IndexModel
@{
    ViewData["Title"] = "Client Sink Configuration";
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-home"></i> Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
            <li class="breadcrumb-item active" aria-current="page">Client Sink Config</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-plug text-primary"></i> Client Sink Configuration
            </h1>
            <p class="text-muted">
                Manage how clients send reports to the backend. Configure Azure Queue, Web API, and FileShare sinks.
            </p>
        </div>
        <div class="col-auto">
            <a asp-page="./Edit" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Configuration
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Info Card -->
    <div class="card mb-4 border-info">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-info-circle"></i> About Client Sink Configuration</h5>
        </div>
        <div class="card-body">
            <p class="mb-0">
                Client sink configuration is stored in the database and distributed to clients via the API.
                Clients will automatically use the active configuration when sending reports.
                Only one configuration can be active at a time.
            </p>
        </div>
    </div>

    <!-- Configurations List -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-list"></i> Sink Configurations</h5>
        </div>
        <div class="card-body">
            @if (Model.Configurations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Enabled Sinks</th>
                                <th>Strategy</th>
                                <th>Priority</th>
                                <th>Retry Config</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var config in Model.Configurations)
                            {
                                <tr class="@(config.IsActive ? "table-success" : "")">
                                    <td>
                                        @if (config.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-circle"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (config.EnableWebApi)
                                        {
                                            <span class="badge bg-primary me-1">
                                                <i class="fas fa-globe"></i> Web API
                                            </span>
                                        }
                                        @if (config.EnableAzureQueue)
                                        {
                                            <span class="badge bg-info me-1">
                                                <i class="fab fa-microsoft"></i> Azure Queue
                                            </span>
                                        }
                                        @if (config.EnableFileShare)
                                        {
                                            <span class="badge bg-warning me-1">
                                                <i class="fas fa-folder"></i> FileShare
                                            </span>
                                        }
                                        @if (!config.EnableWebApi && !config.EnableAzureQueue && !config.EnableFileShare)
                                        {
                                            <span class="text-muted">None enabled</span>
                                        }
                                    </td>
                                    <td>
                                        <code class="small">@config.ExecutionStrategy</code>
                                    </td>
                                    <td>
                                        <small>@config.SinkPriority</small>
                                    </td>
                                    <td>
                                        <small>
                                            @config.MaxRetryAttempts attempts<br />
                                            @TimeSpan.FromSeconds(config.RetryDelaySeconds).ToString(@"mm\:ss") delay
                                            @if (config.UseExponentialBackoff)
                                            {
                                                <br /><span class="badge bg-warning text-dark">Exponential</span>
                                            }
                                        </small>
                                    </td>
                                    <td>
                                        <small>
                                            @config.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")
                                            @if (!string.IsNullOrEmpty(config.UpdatedBy))
                                            {
                                                <br />
                                                <text>by @config.UpdatedBy</text>
                                            }
                                        </small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="./Edit" asp-route-id="@config.Id" 
                                               class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (!config.IsActive)
                                            {
                                                <form method="post" asp-page-handler="Activate" asp-route-id="@config.Id" 
                                                      class="d-inline" onsubmit="return confirm('Activate this configuration? This will deactivate the current active configuration.');">
                                                    <button type="submit" class="btn btn-outline-success" title="Activate">
                                                        <i class="fas fa-power-off"></i>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@config.Id" 
                                                      class="d-inline" onsubmit="return confirm('Are you sure you want to delete this configuration?');">
                                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle"></i> No configurations found. Create your first configuration to get started.
                </div>
            }
        </div>
    </div>

    <!-- Help Card -->
    <div class="card mt-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-question-circle"></i> Help</h5>
        </div>
        <div class="card-body">
            <h6>Sink Types</h6>
            <ul>
                <li><strong>Web API:</strong> Direct HTTP POST to API endpoint (recommended for most deployments)</li>
                <li><strong>Azure Queue:</strong> Messages queued in Azure Storage Queue for asynchronous processing</li>
                <li><strong>FileShare:</strong> JSON files written to network share (for air-gapped environments)</li>
            </ul>

            <h6 class="mt-3">Execution Strategies</h6>
            <ul>
                <li><strong>StopOnFirstSuccess:</strong> Stop after first successful sink (faster, default)</li>
                <li><strong>TryAll:</strong> Send to all enabled sinks (redundancy, slower)</li>
            </ul>

            <h6 class="mt-3">Priority Order</h6>
            <p class="small mb-0">
                Defines the order in which sinks are tried. Format: comma-separated list (e.g., "WebApi,AzureQueue,FileShare").
                Only enabled sinks are executed.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
