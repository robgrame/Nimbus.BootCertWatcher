@using Microsoft.Extensions.Options
@using System.Reflection
@inject IOptions<SecureBootDashboard.Web.Services.ApiSettings> ApiSettings
@{
    var assembly = Assembly.GetExecutingAssembly();
    
    // Ottieni la versione dall'assembly con fallback a "1.0.0"
    var fullVersion = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion 
                      ?? assembly.GetName().Version?.ToString() 
                      ?? "1.0.0";
    
    // Estrai solo la versione principale (rimuovi commit hash e pre-release)
    // Formato possibili: "1.11.0", "1.11.0+abc123", "1.11.0-alpha.0", "1.11.0-alpha.0+abc123"
    var shortVersion = fullVersion;
    
    // Rimuovi commit hash (tutto dopo '+')
    if (shortVersion.Contains('+'))
    {
        shortVersion = shortVersion.Substring(0, shortVersion.IndexOf('+'));
    }
    
    // Rimuovi suffisso pre-release (tutto dopo '-')
    if (shortVersion.Contains('-'))
    {
        shortVersion = shortVersion.Substring(0, shortVersion.IndexOf('-'));
    }
    
    // Assicurati che non sia vuoto
    if (string.IsNullOrWhiteSpace(shortVersion))
    {
        shortVersion = "1.0.0";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="api-base-url" content="@ApiSettings.Value.BaseUrl" />
    <title>@ViewData["Title"] - Secure Boot Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/splash.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/signalr.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SecureBootDashboard.Web.styles.css" asp-append-version="true" />
    
    @* Bootstrap Icons *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    @* Font Awesome for icons *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" 
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    @* Render optional Styles section from pages *@
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        /* Logo navbar styling */
        .navbar-brand {
            font-weight: 600;
            font-size: 1.25rem;
        }
        
        .navbar-brand-logo {
            height: 32px;
            width: auto;
            margin-right: 0.5rem;
            vertical-align: middle;
        }
        
        /* Responsive logo */
        @@media (max-width: 576px) {
            .navbar-brand-logo {
                height: 28px;
            }
            .navbar-brand {
                font-size: 1rem;
            }
        }
    </style>
    <link rel="icon" type="image/png" href="~/lock.png">
</head>
<body>
    @* Splash Screen *@
    <div id="splash-screen" class="splash-screen">
        <img src="~/images/LogoT.webp" alt="Secure Boot Dashboard" class="splash-logo">
        <h1 class="splash-title">Secure Boot Dashboard</h1>
        <p class="splash-subtitle">Secure Boot Certificate Monitoring</p>
        <div class="splash-loader"></div>
        <p class="splash-loading-text">Loading...</p>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/logo.webp" alt="Secure Boot Dashboard Logo" class="navbar-brand-logo">
                    <span class="ms-2">Secure Boot Dashboard</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index">
                                <i class="fas fa-chart-line"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Devices/List">
                                <i class="fas fa-laptop"></i> Devices
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Windows/Versions">
                                <i class="fab fa-windows"></i> Windows Versions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/ClientVersions">
                                <i class="fas fa-download"></i> Client Versions
                            </a>
                        </li>
                        
                        @* Admin Menu Dropdown *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light" href="#" id="adminDropdown" role="button" 
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-tools"></i> Admin
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                <li>
                                    <h6 class="dropdown-header">
                                        <i class="fas fa-cog"></i> Configuration
                                    </h6>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Settings/Index" data-page="/Settings/Index">
                                        <i class="fas fa-sliders-h"></i> Application Settings
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Settings/SinkConfig/Index" data-page="/Settings/SinkConfig">
                                        <i class="fas fa-plug"></i> Client Sink Configuration
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Settings/ApiConfig/Index" data-page="/Settings/ApiConfig">
                                        <i class="fas fa-server"></i> API Configuration
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Admin/MutualTls/Index" data-page="/Admin/MutualTls">
                                        <i class="fas fa-shield-alt"></i> Mutual TLS
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <h6 class="dropdown-header">
                                        <i class="fas fa-database"></i> Data Management
                                    </h6>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Devices/Cleanup" data-page="/Devices/Cleanup">
                                        <i class="fas fa-trash-alt"></i> Device Cleanup
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/About">
                                <i class="fas fa-info-circle"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Privacy">
                                <i class="fas fa-lock"></i> Privacy
                            </a>
                        </li>
                    </ul>
                    
                    @* SignalR Status in Navbar *@
                    <ul class="navbar-nav mx-3">
                        <li class="nav-item">
                            <span class="nav-link signalr-status-navbar" id="signalr-status-navbar">
                                <i class="fas fa-circle-notch fa-spin me-1" id="signalr-icon"></i>
                                <span id="signalr-text">Connecting...</span>
                            </span>
                        </li>
                    </ul>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-page="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <span>&copy; 2025 - Secure Boot Dashboard</span>
                    <span class="mx-2">|</span>
                    <a asp-area="" asp-page="/Privacy">Privacy</a>
                    <span class="mx-2">|</span>
                    <a asp-area="" asp-page="/About">About</a>
                    <span class="mx-2">|</span>
                    <span class="badge bg-secondary" title="Application Version">
                        <i class="fas fa-code-branch"></i> v@(shortVersion)
                    </span>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">
                        <i class="fas fa-heart me-1 text-danger"></i> Made with passion for IT Community
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    @* SignalR Client Library *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" 
            integrity="sha512-7rhBJh1om/W5Ztx7WiYOR9h2wlSaTmPyQMoHFtbT/FVNIA12y6S6I8HY9mrBS1uJ3dSU/R3qaSAXsGYuRjMDxg=="
            crossorigin="anonymous"></script>
    
    @* SignalR Dashboard Client *@
    <script src="~/js/dashboard-realtime.js" asp-append-version="true"></script>
    
    <script src="~/js/splash.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Highlight active page in Admin dropdown
        document.addEventListener('DOMContentLoaded', function() {
            var currentPath = window.location.pathname;
            
            // Check admin dropdown items
            var dropdownItems = document.querySelectorAll('#adminDropdown + .dropdown-menu .dropdown-item[data-page]');
            dropdownItems.forEach(function(item) {
                var itemPage = item.getAttribute('data-page');
                if (currentPath.indexOf(itemPage) !== -1) {
                    item.classList.add('active');
                    // Also highlight the Admin dropdown toggle
                    document.getElementById('adminDropdown').classList.add('text-warning');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>