@page "{version?}"
@model SecureBootDashboard.Web.Pages.Windows.BuildsModel
@{
    ViewData["Title"] = $"Windows {Model.Version} Details";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">
                <i class="fab fa-windows text-primary"></i> Windows @Model.Version
            </h1>
            <p class="lead text-muted">Version details and support information</p>
        </div>
        <div class="col-auto">
            <a asp-page="/Windows/Versions" class="btn btn-outline-primary btn-lg">
                <i class="fas fa-arrow-left"></i> Back to Versions
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.VersionDetails != null)
    {
        <!-- Version Details Card -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-@(Model.VersionDetails.IsSupported ? "success" : "danger")">
                    <div class="card-header bg-@(Model.VersionDetails.IsSupported ? "success" : "danger") text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle"></i> @Model.VersionDetails.Name
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Version Information</h6>
                                <table class="table table-sm">
                                    <tbody>
                                        <tr>
                                            <th style="width: 40%;">
                                                <i class="fas fa-tag"></i> Version
                                            </th>
                                            <td>
                                                <strong class="text-primary">@Model.VersionDetails.Version</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>
                                                <i class="fas fa-file-signature"></i> Name
                                            </th>
                                            <td>@Model.VersionDetails.Name</td>
                                        </tr>
                                        <tr>
                                            <th>
                                                <i class="fas fa-calendar-alt"></i> Release Date
                                            </th>
                                            <td>
                                                @if (Model.VersionDetails.ReleaseDate.HasValue)
                                                {
                                                    <span>@Model.VersionDetails.ReleaseDate.Value.ToString("MMMM dd, yyyy")</span>
                                                    <br>
                                                    <small class="text-muted">
                                                        (@((DateTime.UtcNow - Model.VersionDetails.ReleaseDate.Value).Days) days ago)
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unknown</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>
                                                <i class="fas fa-sync-alt"></i> Last Synced
                                            </th>
                                            <td>
                                                <small class="text-muted">
                                                    @Model.VersionDetails.LastSyncedUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                                </small>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Support Status</h6>
                                @if (Model.VersionDetails.EndOfSupportDate.HasValue)
                                {
                                    var daysUntilEol = (Model.VersionDetails.EndOfSupportDate.Value - DateTime.UtcNow).Days;
                                    
                                    <div class="alert alert-@(daysUntilEol < 0 ? "danger" : (daysUntilEol < 90 ? "warning" : "success"))">
                                        <h5 class="alert-heading">
                                            @if (daysUntilEol < 0)
                                            {
                                                <i class="fas fa-times-circle"></i>
                                                <span> End of Support Reached</span>
                                            }
                                            else if (daysUntilEol < 90)
                                            {
                                                <i class="fas fa-exclamation-triangle"></i>
                                                <span> Support Ending Soon</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check-circle"></i>
                                                <span> Currently Supported</span>
                                            }
                                        </h5>
                                        <hr>
                                        <p class="mb-2">
                                            <strong>End of Support:</strong> @Model.VersionDetails.EndOfSupportDate.Value.ToString("MMMM dd, yyyy")
                                        </p>
                                        @if (daysUntilEol >= 0)
                                        {
                                            <p class="mb-0">
                                                <strong>Days Remaining:</strong> @daysUntilEol days
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="mb-0 text-danger">
                                                <strong>This version is no longer supported by Microsoft</strong>
                                            </p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success">
                                        <h5 class="alert-heading">
                                            <i class="fas fa-check-circle"></i> Currently Supported
                                        </h5>
                                        <hr>
                                        <p class="mb-0">
                                            This version is currently supported by Microsoft.
                                            No end-of-support date has been announced yet.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Build Details Coming Soon -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-code-branch"></i> Build Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-0">
                            <h5 class="alert-heading">
                                <i class="fas fa-info-circle"></i> Build History Coming Soon
                            </h5>
                            <p>Detailed build history and KB article information will be available in a future update.</p>
                            <hr>
                            <p class="mb-0">
                                <strong>Current Features:</strong>
                            </p>
                            <ul class="mb-0">
                                <li>Version and release date tracking</li>
                                <li>End-of-support monitoring</li>
                                <li>Sync status from Office Versions API</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-link"></i> Quick Links
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-4">
                                <a href="https://learn.microsoft.com/en-us/windows/release-health/" 
                                   target="_blank" 
                                   class="btn btn-outline-primary btn-lg w-100 mb-2">
                                    <i class="fas fa-book"></i> Windows Release Health
                                    <i class="fas fa-external-link-alt fa-xs"></i>
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="https://support.microsoft.com/en-us/windows" 
                                   target="_blank" 
                                   class="btn btn-outline-primary btn-lg w-100 mb-2">
                                    <i class="fas fa-life-ring"></i> Windows Support
                                    <i class="fas fa-external-link-alt fa-xs"></i>
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="https://techcommunity.microsoft.com/category/windows" 
                                   target="_blank" 
                                   class="btn btn-outline-primary btn-lg w-100 mb-2">
                                    <i class="fas fa-users"></i> Windows Tech Community
                                    <i class="fas fa-external-link-alt fa-xs"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">
            <h4 class="alert-heading">
                <i class="fas fa-exclamation-triangle"></i> No Version Information
            </h4>
            <p>Unable to load version information for Windows @Model.Version.</p>
            <hr>
            <p class="mb-0">
                <a asp-page="/Windows/Versions" class="btn btn-primary">
                    <i class="fas fa-arrow-left"></i> Back to Versions
                </a>
            </p>
        </div>
    }
</div>

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        
        .btn-lg {
            padding: 1rem;
        }
    </style>
}
