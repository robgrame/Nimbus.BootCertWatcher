<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @{
        var pageTitle = (ViewData["Title"] as string) ?? "Windows Versions - Modern Tracker";
        var pageDescription = (ViewData["Description"] as string) ?? "Stay updated with the latest Windows 10 and Windows 11 versions and updates";
        var baseKeywords = "Windows 10, Windows 11, Windows Updates, KB Articles, Windows Version History, Windows Build Numbers, Windows Release Dates, Windows Versions, Windows 10 Updates, Windows 11 Updates, Windows Version Tracker, IT Administrator Tools, LTSC, GA, Servicing Channel, Feature Update, Cumulative Update";
        var extraKeywords = string.Empty;
        var lowerTitle = pageTitle.ToLowerInvariant();
        if (lowerTitle.Contains("windows 10")) extraKeywords += ", Windows 10 version history, Windows 10 KB, Windows 10 LTSC, Windows 10 22H2, Windows 10 build numbers";
        if (lowerTitle.Contains("windows 11")) extraKeywords += ", Windows 11 version history, Windows 11 KB, Windows 11 LTSC, Windows 11 24H2, Windows 11 build numbers";
        var pageKeywords = baseKeywords + extraKeywords;
        var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";
    }
    <meta name="description" content="@(pageDescription)" />
    <meta name="keywords" content="@(ViewData["Keywords"] as string ?? pageKeywords)" />
    <meta name="robots" content="all" />
    <meta name="language" content="en-US" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content="@(pageTitle)" />
    <meta property="og:image" content="~/images/windows_logo.png" />
    <meta property="og:description" content="@(pageDescription)" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Windows Versions" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(pageTitle)" />
    <meta name="twitter:description" content="@(pageDescription)" />
    <meta name="twitter:image" content="~/images/windows_logo.png" />

    <!-- Author and Contact -->
    <meta name="author" content="Windows Versions Admin" />

    <!-- Title and Favicon -->
    <title>@pageTitle - Windows Versions</title>
    <!-- Use Windows glyph from Bootstrap Icons as favicon, keep ICO as fallback -->
    <link rel="icon" type="image/svg+xml" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/icons/windows.svg">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Modern CSS Framework -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <!-- Custom Modern Styles -->
    <link href="~/css/modern-styles.css" rel="stylesheet" type="text/css">
    <link href="~/css/site.css" rel="stylesheet" type="text/css">
    <link href="~/css/pulse-animation.css" rel="stylesheet" type="text/css">
</head>

<body>
    <div class="site-container">
        <!-- Modern Navigation -->
        <nav class="navbar navbar-expand-lg modern-navbar">
            <div class="container">
                <a class="navbar-brand-modern" href="/">
                    <div class="brand-icon">
                        <i class="bi bi-windows"></i>
                    </div>
                    <span>Windows Versions</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-microsoft me-1"></i>Windows Versions
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-page="/Windows10">
                                        <i class="bi bi-window me-2"></i>Windows 10
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Windows11">
                                        <i class="bi bi-window-dock me-2"></i>Windows 11
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Compare">
                                        <i class="bi bi-arrow-left-right me-2"></i>Compare Versions
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/About">
                                <i class="bi bi-info-circle me-1"></i>About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Privacy">
                                <i class="bi bi-shield-lock me-1"></i>Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger" target="_blank">
                                <i class="bi bi-code-square me-1"></i>API
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Live Data Indicator with Pulse - Simplified -->
                <div class="d-none d-lg-block ms-3">
                    <small class="text-muted">
                        <span class="nav-pulse"></span>
                        <span>Live Data</span>
                    </small>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="main-content">
            @RenderBody()
        </main>

        <!-- Modern Footer -->
        <footer class="modern-footer">
            <div class="container">
                <div class="footer-content">
                    <div class="footer-links">
                        <a asp-page="/Index">Home</a>
                        <a asp-page="/Windows10">Windows 10</a>
                        <a asp-page="/Windows11">Windows 11</a>
                        <a asp-page="/Compare">Compare</a>
                        <a asp-page="/Privacy">Privacy</a>
                        <a href="/swagger" target ="_blank">API Docs</a>
                        <a href="https://github.com/robgrame/WindowsVersionsCore" target ="_blank">
                            <i class="bi bi-github me-1"></i>GitHub
                        </a>
                    </div>
                    <p class="mb-2">
                        <strong>Disclaimer:</strong> This site is not affiliated with Microsoft Corporation.
                        All trademarks are property of their respective owners.
                    </p>
                    <p class="mb-0">
                        &copy; @DateTime.Now.Year Windows Versions - Built with ❤️ for the IT community
                    </p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Global Scripts -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Add scrolled class to navbar
            const navbar = document.querySelector('.modern-navbar');
            window.addEventListener('scroll', function() {
                if (window.scrollY > 10) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
            });

            // Initialize tooltips
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
