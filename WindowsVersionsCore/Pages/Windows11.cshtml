@page
@model Windows11Model
@{
    ViewData["Title"] = "Windows 11 Updates and Versions";
}

<!-- Hero Section (match home header) -->
<section class="hero-section win11">
    <div class="container">
        <div class="hero-content fade-in-up">
            <h1 class="hero-title">Windows 11</h1>
            <p class="hero-subtitle">Complete version history and update information</p>
        </div>
    </div>
</section>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12 text-md-end align-self-center">
            <div class="d-flex justify-content-md-end gap-2">
                <span class="badge bg-success">
                    Last updated: @(Model.LastUpdateDate?.ToString("MMM dd, yyyy") ?? "Unknown")
                </span>
                <span class="badge bg-secondary">
                    Total Updates: @Model.Summary?.TotalUpdates
                </span>
                <button id="refresh-all-data" class="btn btn-sm btn-primary ms-2">
                    <i class="fas fa-sync-alt me-1"></i> Refresh All Data
                </button>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0">Current Release Summary</h3>
                </div>
                <div class="card-body">
                    @if (Model.Summary != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">General Availability Channel</h5>
                                    </div>
                                    <div class="card-body">
                                        @if (Model.Summary.RegularVersions.Any())
                                        {
                                            var currentRegular = Model.Summary.RegularVersions.FirstOrDefault(v => v.IsCurrentVersion);
                                            if (currentRegular != null)
                                            {
                                                <h5>Version: @currentRegular.Version</h5>
                                                <p><strong>Build:</strong> @currentRegular.LatestBuild</p>
                                                <p><strong>Released:</strong> @(currentRegular.ReleaseDate?.ToString("MMM dd, yyyy") ?? currentRegular.AvailabilityDate ?? "Unknown")</p>
                                                @if (!string.IsNullOrEmpty(currentRegular.EndOfServicingConsumer))
                                                {
                                                    <p><strong>End of service (Home/Pro):</strong> @currentRegular.EndOfServicingConsumer</p>
                                                }
                                                @if (!string.IsNullOrEmpty(currentRegular.EndOfServicingEnterprise))
                                                {
                                                    <p><strong>End of service (Enterprise):</strong> @currentRegular.EndOfServicingEnterprise</p>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-warning">No current version marked in Regular Channel</p>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-warning">No Regular Channel versions available</p>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-secondary text-white">
                                        <h5 class="mb-0">Long-Term Servicing Channel (LTSC)</h5>
                                    </div>
                                    <div class="card-body">
                                        @if (Model.Summary.LtscVersions.Any())
                                        {
                                            var currentLtsc = Model.Summary.LtscVersions.FirstOrDefault(v => v.IsCurrentVersion);
                                            if (currentLtsc != null)
                                            {
                                                <h5>Version: @currentLtsc.Version</h5>
                                                <p><strong>Build:</strong> @currentLtsc.LatestBuild</p>
                                                <p><strong>Released:</strong> @(currentLtsc.ReleaseDate?.ToString("MMM dd, yyyy") ?? currentLtsc.AvailabilityDate ?? "Unknown")</p>
                                                @if (!string.IsNullOrEmpty(currentLtsc.MainstreamSupportEndDate))
                                                {
                                                    <p><strong>Mainstream support end:</strong> @currentLtsc.MainstreamSupportEndDate</p>
                                                }
                                                @if (!string.IsNullOrEmpty(currentLtsc.ExtendedSupportEndDate))
                                                {
                                                    <p><strong>Extended support end:</strong> @currentLtsc.ExtendedSupportEndDate</p>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-warning">No current version marked in LTSC Channel</p>
                                            }
                                        }
                                        else
                                        {
                                            <p>No LTSC Channel versions available</p>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-12 mt-3">
                                <div class="alert alert-success">
                                    <h5>Quick Facts</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><i class="fas fa-info-circle me-2"></i>Windows 11 was released on October 5, 2021</p>
                                            <p><i class="fas fa-laptop me-2"></i>Requires TPM 2.0 and UEFI Secure Boot</p>
                                            <p><i class="fas fa-microchip me-2"></i>Minimum: 64-bit processor, 4GB RAM, 64GB storage</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Total Updates:</strong> @Model.Summary.TotalUpdates</p>
                                            <p><strong>Security Updates:</strong> @Model.Summary.SecurityUpdates</p>
                                            <p><strong>Last Update:</strong> @(Model.Summary.LastUpdateDate?.ToString("MMMM dd, yyyy") ?? "Unknown")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <p>Windows 11 summary information is currently unavailable.</p>
                            <p>You may need to refresh the data from Microsoft sources. Please click the "Refresh All Data" button at the top of the page.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0">Recent Versions</h3>
                </div>
                <div class="card-body">
                    @if (Model.Summary?.RecentVersions?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Version</th>
                                        <th>Channel</th>
                                        <th>Build</th>
                                        <th>Released</th>
                                        <th>End of Support</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var version in Model.Summary.RecentVersions)
                                    {
                                        var eosRaw = version.ServicingType == WindowsVersionsCore.Models.ServicingType.Regular
                                            ? version.EndOfServicingEnterprise
                                            : version.ExtendedSupportEndDate;
                                        DateTime eosDateParsed;
                                        var eosDisplay = !string.IsNullOrWhiteSpace(eosRaw) && DateTime.TryParse(eosRaw, out eosDateParsed)
                                            ? eosDateParsed.ToString("MMM dd, yyyy")
                                            : (string.IsNullOrWhiteSpace(eosRaw) ? "Unknown" : eosRaw);
                                        <tr>
                                            <td>@version.Version</td>
                                            <td>
                                                @{ var ch = version.ServicingType == WindowsVersionsCore.Models.ServicingType.Regular ? "GA" : version.ServicingType.ToString(); }
                                                <span class="badge bg-light text-dark">@ch</span>
                                            </td>
                                            <td>@version.Build</td>
                                            <td>@(version.ReleaseDate?.ToString("MMM dd, yyyy") ?? "Unknown")</td>
                                            <td>@eosDisplay</td>
                                            <td>
                                                @if (version.IsCurrentVersion)
                                                {
                                                    <span class="badge bg-success">Current</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Previous</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <p>No recent versions available.</p>
                            <p>You may need to refresh the data from Microsoft sources.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0">Recent Updates</h3>
                </div>
                <div class="card-body">
                    @if (Model.Summary?.RecentUpdates?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>KB</th>
                                        <th>Version</th>
                                        <th>Build</th>
                                        <th>Released</th>
                                        <th>Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var update in Model.Summary.RecentUpdates)
                                    {
                                        <tr>
                                            <td>@update.KBNumber</td>
                                            <td>@update.Version</td>
                                            <td>@update.Build</td>
                                            <td>@(update.ReleaseDate?.ToString("MMM dd, yyyy") ?? "Unknown")</td>
                                            <td>
                                                @if (update.IsSecurityUpdate)
                                                {
                                                    <span class="badge bg-danger">Security</span>
                                                }
                                                else if (!string.IsNullOrEmpty(update.Type))
                                                {
                                                    <span class="badge bg-info">@update.Type</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">Update</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <p>No recent updates available.</p>
                            <p>You may need to refresh the data from Microsoft sources.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">All Windows 11 Updates</h3>
                    <button id="refresh-updates" class="btn btn-sm btn-light">
                        <i class="fas fa-sync-alt me-1"></i> Refresh
                    </button>
                </div>
                <div class="card-body">
                    <div id="updates-container">
                        <div class="text-center my-4">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading Windows 11 update history...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0">Windows 11 Versions</h3>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="versionsTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="regular-tab" data-bs-toggle="tab" data-bs-target="#regular" type="button" role="tab" aria-controls="regular" aria-selected="true">Regular Versions</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="ltsc-tab" data-bs-toggle="tab" data-bs-target="#ltsc" type="button" role="tab" aria-controls="ltsc" aria-selected="false">LTSC Editions</button>
                        </li>
                    </ul>
                    <div class="tab-content pt-3" id="versionsTabContent">
                        <!-- Regular Versions Tab -->
                        <div class="tab-pane fade show active" id="regular" role="tabpanel" aria-labelledby="regular-tab">
                            @if (Model.Summary?.RegularVersions?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-success">
                                            <tr>
                                                <th>Version</th>
                                                <th>Servicing Option</th>
                                                <th>Build</th>
                                                <th>Availability Date</th>
                                                <th>End of Service (Home/Pro)</th>
                                                <th>End of Service (Enterprise/Education)</th>
                                                <th>Latest Update</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var version in Model.Summary.RegularVersions)
                                            {
                                                <tr>
                                                    <td>@version.Version</td>
                                                    <td>@version.ServicingOption</td>
                                                    <td>@version.LatestBuild</td>
                                                    <td>@version.AvailabilityDate</td>
                                                    <td>@version.EndOfServicingConsumer</td>
                                                    <td>@version.EndOfServicingEnterprise</td>
                                                    <td>@version.LatestUpdate</td>
                                                    <td>
                                                        @if (version.IsCurrentVersion)
                                                        {
                                                            <span class="badge bg-success">Current</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Previous</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p>No regular Windows 11 versions available.</p>
                                </div>
                            }
                        </div>
                        
                        <!-- LTSC Versions Tab -->
                        <div class="tab-pane fade" id="ltsc" role="tabpanel" aria-labelledby="ltsc-tab">
                            @if (Model.Summary?.LtscVersions?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-success">
                                            <tr>
                                                <th>Version</th>
                                                <th>Servicing Option</th>
                                                <th>Build</th>
                                                <th>Availability Date</th>
                                                <th>Mainstream Support End</th>
                                                <th>Extended Support End</th>
                                                <th>Latest Update</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var version in Model.Summary.LtscVersions)
                                            {
                                                <tr>
                                                    <td>@version.Version</td>
                                                    <td>@version.ServicingOption</td>
                                                    <td>@version.LatestBuild</td>
                                                    <td>@version.AvailabilityDate</td>
                                                    <td>@version.MainstreamSupportEndDate</td>
                                                    <td>@version.ExtendedSupportEndDate</td>
                                                    <td>@version.LatestUpdate</td>
                                                    <td>
                                                        @if (version.IsCurrentVersion)
                                                        {
                                                            <span class="badge bg-success">Current</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Previous</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="alert alert-info mt-3">
                                    <p><i class="fas fa-info-circle me-2"></i><strong>Long-Term Servicing Channel (LTSC)</strong> editions of Windows 11 are designed for specialized devices and receive security updates for up to 10 years.</p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p>No LTSC Windows 11 versions available.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load all Windows 11 updates
            loadUpdates();
            
            // Refresh button handler (specific to the updates table)
            $('#refresh-updates').click(function() {
                $(this).prop('disabled', true);
                $(this).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Refreshing...');

                fetchUpdateData();
            });
            
            // Refresh ALL data handler (including forcing a fetch from Microsoft)
            $('#refresh-all-data').click(function() {
                const btn = $(this);
                btn.prop('disabled', true);
                btn.html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Refreshing...');
                
                // Show a loading overlay
                const overlay = $('<div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex justify-content-center align-items-center" style="z-index: 9999;">' + 
                                '<div class="card p-4">' +
                                '<div class="text-center">' +
                                '<div class="spinner-border text-primary mb-3" role="status"></div>' +
                                '<h4>Refreshing Windows 11 Data</h4>' +
                                '<p>Fetching updates from Microsoft sources...</p>' +
                                '<p class="small text-muted">This may take up to 60 seconds</p>' +
                                '</div></div></div>');
                $('body').append(overlay);
                
                // Force a refresh of data from Microsoft sources
                $.post('/api/Windows/refresh')
                    .done(function(response) {
                        if (response.success) {
                            // Reload the page to get fresh data
                            window.location.reload();
                        } else {
                            overlay.remove();
                            alert('Error refreshing data: ' + response.message);
                            btn.prop('disabled', false);
                            btn.html('<i class="fas fa-sync-alt me-1"></i> Refresh All Data');
                        }
                    })
                    .fail(function(error) {
                        overlay.remove();
                        alert('Failed to refresh data from Microsoft. Please try again later.');
                        btn.prop('disabled', false);
                        btn.html('<i class="fas fa-sync-alt me-1"></i> Refresh All Data');
                    });
            });
            
            function loadUpdates() {
                fetchUpdateData();
            }
            
            function fetchUpdateData() {
                $.get('/api/Windows11/updates')
                    .done(function(response) {
                        if (response.success && response.data && response.data.length > 0) {
                            const updates = response.data;
                            const sortedUpdates = updates.sort((a, b) => {
                                // Sort by release date (newest first)
                                const dateA = a.releaseDate ? new Date(a.releaseDate) : new Date(0);
                                const dateB = b.releaseDate ? new Date(b.releaseDate) : new Date(0);
                                return dateB - dateA;
                            });
                            
                            let html = '<div class="table-responsive">';
                            html += '<table class="table table-striped table-hover" id="windows11-updates-table">';
                            html += '<thead><tr><th>KB</th><th>Version</th><th>Build</th><th>Release Date</th><th>Type</th><th>Title</th><th>Details</th></tr></thead>';
                            html += '<tbody>';
                            
                            sortedUpdates.forEach(update => {
                                const releaseDate = update.releaseDate 
                                    ? new Date(update.releaseDate).toLocaleDateString() 
                                    : 'Unknown';
                                    
                                let updateType = 'Update';
                                let badgeClass = 'bg-primary';
                                
                                if (update.isSecurityUpdate) {
                                    updateType = 'Security';
                                    badgeClass = 'bg-danger';
                                } else if (update.isOptionalUpdate) {
                                    updateType = 'Optional';
                                    badgeClass = 'bg-warning text-dark';
                                } else if (update.type) {
                                    updateType = update.type;
                                    badgeClass = 'bg-info';
                                }
                                
                                const updateBadge = `<span class="badge ${badgeClass}">${updateType}</span>`;
                                
                                // Truncate long titles for better display
                                const displayTitle = update.updateTitle && update.updateTitle.length > 60 
                                    ? update.updateTitle.substring(0, 60) + '...' 
                                    : (update.updateTitle || 'N/A');
                                
                                // Create a details button for more information
                                const detailsBtn = `<button type="button" class="btn btn-sm btn-outline-secondary update-details-btn" 
                                                    data-kb="${update.kbNumber || ''}" 
                                                    data-title="${update.updateTitle || ''}" 
                                                    data-desc="${update.description || ''}"
                                                    data-version="${update.version || ''}"
                                                    data-build="${update.build || ''}"
                                                    data-date="${releaseDate}">
                                                    <i class="fas fa-info-circle"></i>
                                                   </button>`;
                                
                                html += `<tr>
                                    <td>${update.kbNumber || 'N/A'}</td>
                                    <td>${update.version || 'N/A'}</td>
                                    <td>${update.build || 'N/A'}</td>
                                    <td>${releaseDate}</td>
                                    <td>${updateBadge}</td>
                                    <td>${displayTitle}</td>
                                    <td>${detailsBtn}</td>
                                </tr>`;
                            });
                            
                            html += '</tbody></table></div>';
                            
                            // Add search/filter functionality
                            html += `
                                <div class="mt-3">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <div class="input-group">
                                                <input type="text" id="update-search" class="form-control" placeholder="Search updates...">
                                                <button class="btn btn-outline-secondary" type="button" id="clear-search">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <select id="update-type-filter" class="form-select">
                                                <option value="">All Types</option>
                                                <option value="security">Security Only</option>
                                                <option value="optional">Optional Only</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            `;
                            
                            $('#updates-container').html(html);
                            
                            // Setup search functionality
                            $('#update-search').on('keyup', function() {
                                const value = $(this).val().toLowerCase();
                                $('#windows11-updates-table tbody tr').filter(function() {
                                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                                });
                            });
                            
                            // Clear search
                            $('#clear-search').on('click', function() {
                                $('#update-search').val('');
                                $('#windows11-updates-table tbody tr').show();
                            });
                            
                            // Setup filter functionality
                            $('#update-type-filter').on('change', function() {
                                const value = $(this).val().toLowerCase();
                                if (value === '') {
                                    $('#windows11-updates-table tbody tr').show();
                                } else if (value === 'security') {
                                    $('#windows11-updates-table tbody tr').each(function() {
                                        $(this).toggle($(this).find('td:eq(4)').text().toLowerCase().indexOf('security') > -1);
                                    });
                                } else if (value === 'optional') {
                                    $('#windows11-updates-table tbody tr').each(function() {
                                        $(this).toggle($(this).find('td:eq(4)').text().toLowerCase().indexOf('optional') > -1);
                                    });
                                }
                            });
                            
                            // Setup details button handlers
                            $('.update-details-btn').on('click', function() {
                                const kb = $(this).data('kb');
                                const title = $(this).data('title');
                                const desc = $(this).data('desc');
                                const version = $(this).data('version');
                                const build = $(this).data('build');
                                const date = $(this).data('date');
                                
                                // Create a modal with details
                                const modalHtml = `
                                    <div class="modal fade" id="updateDetailsModal" tabindex="-1" aria-labelledby="updateDetailsModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                                <div class="modal-header bg-success text-white">
                                                    <h5 class="modal-title" id="updateDetailsModalLabel">Update Details: ${kb}</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <h4>${title}</h4>
                                                    <div class="mb-3">
                                                        <span class="badge bg-secondary me-2">Version: ${version}</span>
                                                        <span class="badge bg-secondary me-2">Build: ${build}</span>
                                                        <span class="badge bg-secondary">Released: ${date}</span>
                                                    </div>
                                                    <div class="mt-3">
                                                        <h5>Description</h5>
                                                        <p>${desc || 'No description available.'}</p>
                                                    </div>
                                                    <div class="mt-3">
                                                        <a href="https://support.microsoft.com/help/${kb.replace('KB', '')}" target="_blank" class="btn btn-sm btn-outline-primary">
                                                            <i class="fas fa-external-link-alt me-1"></i> Microsoft Support Page
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                
                                // Remove any existing modals and add the new one
                                $('#updateDetailsModal').remove();
                                $('body').append(modalHtml);
                                
                                // Show the modal
                                new bootstrap.Modal(document.getElementById('updateDetailsModal')).show();
                            });
                            
                        } else {
                            $('#updates-container').html(`
                                <div class="alert alert-warning">
                                    <h4>No Windows 11 updates available</h4>
                                    <p>The system doesn't currently have any Windows 11 update data in storage.</p>
                                    <p>Please click the "Refresh All Data" button at the top of the page to fetch updates from Microsoft sources.</p>
                                </div>
                            `);
                        }
                        
                        resetRefreshButton();
                    })
                    .fail(function(error) {
                        console.error('API error:', error);
                        $('#updates-container').html(`
                            <div class="alert alert-danger">
                                <h4>Error loading Windows 11 updates</h4>
                                <p>Failed to load Windows 11 updates. Please try again later.</p>
                                <p>Error details: ${error.statusText || 'Unknown error'}</p>
                            </div>
                        `);
                        resetRefreshButton();
                    });
            }
            
            function resetRefreshButton() {
                $('#refresh-updates').prop('disabled', false);
                $('#refresh-updates').html('<i class="fas fa-sync-alt me-1"></i> Refresh');
            }
        });
    </script>
}