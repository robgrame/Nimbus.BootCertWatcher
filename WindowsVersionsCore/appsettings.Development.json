{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "WindowsVersionsCore": "Debug"
    }
  },
  "AzuriteStorage": {
    "UseAzurite": true,
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "WindowsScraper": {
    "Enabled": false,
    "intervalMinutes": 5,
    "InitialDelayMinutes": 1
  }
}
